<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GraphWalkerPruner</AssemblyName>
    <RootNamespace>GraphWalkerPrunerLauncher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="pruner_gui.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="prune_graphwalker_model.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="build_exe.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
